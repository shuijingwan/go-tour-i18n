      "data": "",
      "slots": [
        {
          "id": "b15082c341e737cf7dbca88c7f2526e7698ecec1a2e99ea4fb4f127cb212f622",
          "text": "云与网络服务"
        },
        {
          "id": "7af843b53918d0b7c98415d675e299ac75968d38126e3dc8ef31a21c6c8365ed",
          "text": "凭借主流云提供商上强大的工具和 API 生态系统，使用 Go 构建服务比以往更加轻松。"
        },
        {
          "id": "17bc181886d508f22068cd16efacf504d71d8a0fd0bd9a22fb78014191fea1f3",
          "text": "球体"
        },
        {
          "id": "33609748e06583e8ffa02cf4d12f86e6f09b6782c78cbb9162ec8b3fdd5ecae5",
          "text": "命令行界面"
        },
        {
          "id": "a14d473dfd8a0408e4a7909c14cd8de6148d57e22a58b80fbc803c6968338e50",
          "text": "借助流行的开源包和强大的标准库，使用 Go 创建快速、优雅的 CLI。"
        },
        {
          "id": "5cb25cd96f50916fa03d7ef97d3e83a94f1c688885cfa87446632042003317f4",
          "text": "命令行"
        },
        {
          "id": "6d385029d0010d72726788882c31913b409a1f51642a9640b45ef2f7da71380f",
          "text": "Web 开发"
        },
        {
          "id": "04f304292ef59888f72438ffab534187ada18f720e0482f00802fc7edaa87ca0",
          "text": "凭借增强的内存性能和对多种 IDE 的支持，Go 能够为快速、可扩展的 Web 应用提供支持。"
        },
        {
          "id": "04933f042d6f284440aac6948f665308da2bc8c59a70431b0422aaf419f12fe7",
          "text": "代码"
        },
        {
          "id": "176bc6220596c9d55db4a2258bb319b14a08aa64dbf89e8e76a88795be049e33",
          "text": "⟦P0⟧ 与站点可靠性"
        },
        {
          "id": "39f5c78d9ff4bbff41f2d1c46740e32c7b84c78e464b21e5ac53199786d34b04",
          "text": "凭借快速的构建速度、简洁的语法、自动格式化工具和文档生成器，Go 天生适合同时支持 ⟦P0⟧ 和 ⟦P1⟧。"
        },
        {
          "id": "dd7b6bb94f4e610b71d53dd7e6cf04709e52294b5cd9dc7700b2f19556bada59",
          "text": "球体"
        }
      ]
    },
