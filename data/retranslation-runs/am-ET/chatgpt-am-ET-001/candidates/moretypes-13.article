* makeን በመጠቀም ቁራጭ መፍጠር

ቁራጮችን በአብሮ የተሰራው `make` ተግባር መፍጠር ይቻላል፤
በተለዋዋጭ መጠን የሚሰሩ ድርድሮችን የሚፈጥሩትም በዚህ መንገድ ነው።

የ `make` ተግባር ዜሮ የተሞላ ድርድር ይመድባል
እና ወደዚያ ድርድር የሚያመለክት ቁራጭ ይመልሳል፦

	a := make([]int, 5)  // len(a)=5

አቅምን ለመግለጽ፣ ለ `make` ሦስተኛ ነጋሪ እሴት ያስተላልፉ፦

	b := make([]int, 0, 5) // len(b)=0, cap(b)=5

	b = b[:cap(b)] // len(b)=5, cap(b)=5
	b = b[1:]      // len(b)=4, cap(b)=4

.play moretypes/making-slices.go
