           \u003ca href=\"https://go.dev/talks/\"\u003e\n                          演讲录像\n                          \n                        \u003c/a\u003e\n                      \n                    \u003c/li\u003e\n                    \u003cli class=\"NavigationDrawer-listItem\"\u003e\n                        \u003ca href=\"https://www.meetup.com/pro/go\"\u003e\n                          聚会活动\n                           \u003ci class=\"material-icons\"\u003eopen_in_new\u003c/i\u003e\n                        \u003c/a\u003e\n                      \n                    \u003c/li\u003e\n                    \u003cli class=\"NavigationDrawer-listItem\"\u003e\n                        \u003ca href=\"https://go.dev/wiki/Conferences\"\u003e\n                          大会\n                           \u003ci class=\"material-icons\"\u003eopen_in_new\u003c/i\u003e\n                        \u003c/a\u003e\n                      \n                    \u003c/li\u003e\n                    \u003cli class=\"NavigationDrawer-listItem\"\u003e\n                        \u003ca href=\"https://go.dev/blog\"\u003e\n                          Go 博客\n                          \n                        \u003c/a\u003e\n                      \n                    \u003c/li\u003e\n                    \u003cli class=\"NavigationDrawer-listItem\"\u003e\n                        \u003ca href=\"https://go.dev/help\"\u003e\n                          Go 项目\n                          \n                        \u003c/a\u003e\n                      \n                    \u003c/li\u003e\n                    \u003cli class=\"NavigationDrawer-listItem\"\u003e\n                        \u003cdiv\u003e加入交流\u003c/div\u003e\n                        \u003cdiv class=\"Header-socialIcons\"\u003e\n                          \n                            \u003ca class=\"Header-socialIcon\" href=\"https://groups.google.com/g/golang-nuts\"\u003e\u003cimg src=\"/images/logos/social/google-groups.svg\"/\u003e\u003c/a\u003e\n                            \u003ca class=\"Header-socialIcon\" href=\"https://github.com/golang\"\u003e\u003cimg src=\"/images/logos/social/github.svg\"/\u003e\u003c/a\u003e\n                            \u003ca class=\"Header-socialIcon\" href=\"https://bsky.app/profile/golang.org\"\u003e\u003cimg src=\"/images/logos/social/bluesky.svg\"/\u003e\u003c/a\u003e\n                            \u003ca class=\"Header-socialIcon\" href=\"https://hachyderm.io/@golang\"\u003e\u003cimg src=\"/images/logos/social/mastodon.svg\"/\u003e\u003c/a\u003e\n                            \u003ca class=\"Header-socialIcon\" href=\"https://twitter.com/golang\"\u003e\u003cimg src=\"/images/logos/social/twitter.svg\"/\u003e\u003c/a\u003e\n                            \u003ca class=\"Header-socialIcon\" href=\"https://www.reddit.com/r/golang/\"\u003e\u003cimg src=\"/images/logos/social/reddit.svg\"/\u003e\u003c/a\u003e\n                            \u003ca class=\"Header-socialIcon\" href=\"https://invite.slack.golangbridge.org/\"\u003e\u003cimg src=\"/images/logos/social/slack.svg\"/\u003e\u003c/a\u003e\n                            \u003ca class=\"Header-socialIcon\" href=\"https://stackoverflow.com/tags/go\"\u003e\u003cimg src=\"/images/logos/social/stack-overflow.svg\"/\u003e\u003c/a\u003e\n                        \u003c/div\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\n              \u003c/nav\u003e\u003c/div\u003e\n            \n          \u003c/li\u003e\n\n        \n    \u003c/ul\u003e\n  \u003c/nav\u003e\n\u003c/aside\u003e\n\u003cdiv class=\"NavigationDrawer-scrim js-scrim\" role=\"presentation\"\u003e\u003c/div\u003e\n\u003cmain class=\"SiteContent SiteContent--default\" id=\"main-content\"\u003e\n  \u003ch1\u003eFIPS 140-3 合规性\u003c/h1\u003e\u003cp\u003e从 Go 1.24 开始，Go 二进制文件可以原生运行在一种\n有助于满足 FIPS 140-3 合规要求的模式下。此外，工具链还可以针对\n构成 Go 密码模块的密码学包的冻结版本进行构建。\u003c/p\u003e\n\u003ch2 id=\"fips-140-3\"\u003eFIPS 140-3\u003c/h2\u003e\n\u003cp\u003eNIST FIPS 140-3 是 U.S 政府针对密码学\n应用的一套合规制度，其中要求使用一组经批准的\n算法，并使用经过\n\u003ca href=\"https://csrc.nist.gov/projects/cryptographic-module-validation-program\"\u003eCMVP\u003c/a\u003e 验证的\n密码模块，且这些模块需在目标运行环境中接受测试。\u003c/p\u003e\n\u003cp\u003e本页介绍的机制可帮助 Go 应用程序满足相关合规要求。\u003c/p\u003e\n\u003cp\u003e不需要满足 FIPS 140-3 合规要求的应用程序可以安全地忽略这些机制，\n也不应启用 FIPS 140-3 模式。\u003c/p\u003e\n\u003cp\u003e**注意（NOTE）：**仅仅使用符合 FIPS 140-3 要求并通过验证的密码模块，\n本身并不一定能满足所有相关监管要求。Go 团队无法就所提供的\nFIPS 140-3\n模式是否能够满足、或不能满足个别用户的具体监管要求，提供任何\n保证或支持。你需要谨慎判断使用该模块是否满足\n自己的具体要求。\u003c/p\u003e\n\u003ch2 id=\"go-\"\u003eGo 密码模块\u003c/h2\u003e\n\u003cp\u003eGo 密码模块由标准库中的一组 Go 包构成，\n位于 \u003ccode\u003ecrypto/internal/fips140/...\u003c/code\u003e 下，用于实现经 FIPS 140-3 批准的\n算法。\u003c/p\u003e\n\u003cp\u003e公开的 API 包（例如 \u003ccode\u003ecrypto/ecdsa\u003c/code\u003e 和 \u003ccode\u003ecrypto/rand\u003c/code\u003e）会透明地使用\nGo 密码模块来实现 FIPS 140-3 算法。\u003c/p\u003e\n\u003ch2 id=\"fips-140-3-\"\u003eFIPS 140-3 模式\u003c/h2\u003e\n\u003cp\u003e在 FIPS 140-3 模式下运行时：\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eGo 密码模块会在\n\u003ccode\u003einit\u003c/code\u003e 时自动执行完整性自检，将构建时计算的模块目标文件校验和\n与加载到内存中的符号进行比较。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e所有算法都会按照相关的 FIPS\n140-3 实施指南执行已知答案自检，或者在 \u003ccode\u003einit\u003c/code\u003e 时执行，或者在首次使用时执行。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e对生成的密码密钥执行成对一致性测试。\n请注意，对于某些密钥类型，这可能造成最高约 2 倍的性能下降，\n对临时密钥尤其需要注意。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003ca href=\"https://go.dev/pkg/crypto/rand/#Reader\"\u003e\u003ccode\u003ecrypto/rand.Reader\u003c/code\u003e\u003c/a\u003e 的实现基于一个\nNIST SP 800-90A DRBG。为了保证与未在\nFIPS 140-3 模式下运行的程序具有相同安全级别，还会从平台的\nCSPRNG 获取随机字节，并在每次 \u003ccode\u003eRead\u003c/code\u003e 时将其作为不计入熵估算的附加\n数据混入输出。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003ca href=\"https://go.dev/pkg/crypto/tls/\"\u003e\u003ccode\u003ecrypto/tls\u003c/code\u003e\u003c/a\u003e 包会忽略且不会协商\n任何协议版本、密码套件、签名算法或密钥交换\n机制，只要其未经 FIPS 140-3 批准。（这等同于旧版\n可选启用的 \u003ccode\u003ecrypto/tls/fipsonly\u003c/code\u003e Go+BoringCrypto 机制。）\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003ca href=\"https://go.dev/pkg/crypto/rsa/#SignPSS\"\u003e\u003ccode\u003ecrypto/rsa.SignPSS\u003c/code\u003e\u003c/a\u003e 与\n\u003ca href=\"https://go.dev/pkg/crypto/rsa/#PSSSaltLengthAuto\"\u003e\u003ccode\u003ePSSSaltLengthAuto\u003c/code\u003e\u003c/a\u003e 搭配使用时，会把盐的长度\n限制为哈希长度。\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eFIPS 140-3 模式不支持 OpenBSD、Wasm、AIX 和 32 位 Windows。\u003c/p\u003e\n\u003ch2 id=\"cryptofips140-\"\u003e\u003ccode\u003ecrypto/fips140\u003c/code\u003e 包\u003c/h2\u003e\n\u003cp\u003e\u003ca href=\"https://go.dev/pkg/crypto/fips140/#Enabled\"\u003e\u003ccode\u003ecrypto/fips140.Enabled\u003c/code\u003e\u003c/a\u003e 函数用于报告\nFIPS 140-3 模式是否处于启用状态。\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://go.dev/pkg/crypto/fips140/#Version\"\u003e\u003ccode\u003ecrypto/fips140.Version\u003c/code\u003e\u003c/a\u003e 函数返回\n当前使用的 Go 密码模块版本。\u003c/p\u003e\n\u003ch2 id=\"gofips140-\"\u003e\u003ccode\u003eGOFIPS140\u003c/code\u003e 环境变量\u003c/h2\u003e\n\u003cp\u003e\u003ccode\u003eGOFIPS140\u003c/code\u003e 环境变量可以与 \u003ccode\u003ego build\u003c/code\u003e、\u003ccode\u003ego install\u003c/code\u003e 和\n\u003ccode\u003ego test\u003c/code\u003e 一起使用，用于选择要链接到\n可执行程序中的 Go 密码模块版本，并默认启用 FIPS 140-3 模式。\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e\u003ccode\u003eoff\u003c/code\u003e 是默认值，使用当前标准库树中的 \u003ccode\u003ecrypto/internal/fips140/...\u003c/code\u003e 包。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003ccode\u003elatest\u003c/code\u003e 与 \u003ccode\u003eoff\u003c/code\u003e 类似，但默认启用 FIPS 140-3 模式。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003ccode\u003ev1.0.0\u003c/code\u003e 或 \u003ccode\u003ev1.26.0\u003c/code\u003e 分别选择对应的特定 Go 密码模块\n版本。它们默认启用 FIPS 140-3 模式。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003ccode\u003einprocess\u003c/code\u003e 和 \u003ccode\u003ecertified\u003c/code\u003e 分别等价于指定最新的版本：\n前者是进入 \u003ca href=\"https://csrc.nist.gov/Projects/cryptographic-module-validation-program/modules-in-process/modules-in-process-list\"\u003eCMVP Modules In Process List\u003c/a\u003e 的最新版本，后者是\n已获得 [CMVP 验证证书][] 的最新版本。\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 id=\"fips140--godebug-\"\u003e\u003ccode\u003efips140\u003c/code\u003e 的 GODEBUG 选项\u003c/h2\u003e\n\u003cp\u003e运行时 \u003ccode\u003efips140\u003c/code\u003e 的 \u003ca href=\"https://go.dev/doc/godebug\"\u003eGODEBUG\u003c/a\u003e 选项控制 Go\n密码模块是否在 FIPS 140-3 模式下运行。程序启动后不能再更改该选项。\u003c/p\u003e\n\u003cp\u003e其默认值为 \u003ccode\u003eoff\u003c/code\u003e，除非在构建时设置了 \u003ccode\u003eGOFIPS140\u003c/code\u003e。\u003c/p\u003e\n\u003cp\u003e如果设为 \u003ccode\u003eon\u003c/code\u003e，则启用 FIPS 140-3 模式。即使构建时未设置 \u003ccode\u003eGOFIPS140\u003c/code\u003e，\n也可以这样做。\u003c/p\u003e\n\u003cp\u003e如果设为 \u003ccode\u003eonly\u003c/code\u003e，不符合 FIPS 140-3 要求的密码算法\n将返回错误或触发 panic。请注意，这是一种尽力而为的模式，旨在\n用于测试、评估和调试。\u003cem\u003e它并不适用于\n生产环境\u003c/em\u003e，安全政策也不要求使用它；它按设计会引入崩溃\n和可能未处理的错误，并且可能出现误报或\n漏报。\u003c/p\u003e\n\u003cp\u003e大多数程序不应直接设置此选项，而应在构建时使用\n\u003ccode\u003eGOFIPS140\u003c/code\u003e。\u003c/p\u003e\n\u003ch2 id=\"heading\"\u003e模块版本、验证与兼容性\u003c/h2\u003e\n\u003cp\u003eGoogle 目前与 \u003ca href=\"https://geomys.org/\"\u003eGeomys\u003c/a\u003e\n建立了合同关系，以推动 Go 密码模块至少每年进行一次 CMVP 验证。\n在进行验证时，我们会冻结 Go 密码模块，并创建\n一个新的模块版本供提交审核。\u003c/p\u003e\n\u003cp\u003e这些验证会在覆盖全面的运行\n环境集合中测试，支持许多常见的操作系统和硬件平台\n组合。\u003c/p\u003e\n\u003cp\u003e只要更新版本尚未获得 CMVP 验证\n证书，较旧的 Go 密码模块版本就会继续得到支持并保持可用。更新版本获得 CMVP 验证\n证书后，旧版本将被移除。\u003c/p\u003e\n\u003cp\u003e如果使用的是从较旧 Go 版本冻结下来的\nGo 密码模块，某些标准库功能可能不可用并返回错误。\u003c/p\u003e\n\u003ch3 id=\"go--v1260\"\u003eGo 密码模块 v1.26.0\u003c/h3\u003e\n\u003cp\u003eGo 密码模块 v1.26.0 于 2026 年初基于 Go 1.26 冻结。\u003c/p\u003e\n\u003cp\u003e它可用于 Go 1.26+。\u003c/p\u003e\n\u003cp\u003e截至 2026-04-28，它在 CMVP Modules In Process List 中处于 Pending Review 状态。\n它由 \u003ca href=\"https://csrc.nist.gov/projects/cryptographic-algorithm-validation-program/details?validation=40638\"\u003eCAVP Certificate A8028\u003c/a\u003e 覆盖。\u003c/p\u003e\n\u003ch4 id=\"-v100-\"\u003e相较于 v1.0.0 的变化\u003c/h4\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e实现了 ML-DSA。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003ca href=\"https://go.dev/pkg/testing/cryptotest#SetGlobalRandom\"\u003etesting/cryptotest.SetGlobalRandom\u003c/a\u003e 现已受支持。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e引入新的 AES-GCM 合规 API，供 \u003ccode\u003ecrypto/hpke\u003c/code\u003e 以及未来公开的 API 使用。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eGo 密码模块现在使用一个 CPU 抖动熵源，并具有\n\u003ca href=\"https://csrc.nist.gov/projects/cryptographic-module-validation-program/entropy-validations/certificate/318\"\u003eESV Certificate #E318\u003c/a\u003e\n以及 \u003ca href=\"https://csrc.nist.gov/projects/cryptographic-algorithm-validation-program/details?product=20498\"\u003eCAVP Certificate A7715\u003c/a\u003e。\n（平台的 CSPRNG 仍会作为不计入熵估算的附加数据源，用于所有随机字节。）\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e进行了多项安全性和性能改进。\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 id=\"go--v100\"\u003eGo 密码模块 v1.0.0\u003c/h3\u003e\n\u003cp\u003eGo 密码模块 v1.0.0 于 2024 年初基于 Go 1.24 冻结。\u003c/p\u003e\n\u003cp\u003e它可用于 Go 1.24+。\u003c/p\u003e\n\u003cp\u003e它由 \u003ca href=\"https://csrc.nist.gov/projects/cryptographic-module-validation-program/certificate/5247\"\u003eCMVP Certificate #5247\u003c/a\u003e\n以及 \u003ca href=\"https://csrc.nist.gov/projects/cryptographic-algorithm-validation-program/details?product=19371\"\u003eCAVP Certificate A6650\u003c/a\u003e 覆盖。\u003c/p\u003e\n\u003ch2 id=\"goboringcrypto\"\u003eGo+BoringCrypto\u003c/h2\u003e\n\u003cp\u003e此前使用 BoringCrypto 模块实现部分\nFIPS 140-3 批准算法的、现已不受支持的机制目前仍可使用，但计划在未来版本中\n移除，并以本页介绍的机制取代。\u003c/p\u003e\n\u003cp\u003eGo+BoringCrypto 与原生 FIPS 140-3 模式不兼容。\u003c/p\u003e\n\n\u003c/main\u003e\n\u003cfooter class=\"Site-footer\"\u003e\n  \u003cdiv class=\"Footer\"\u003e\n    \u003cdiv class=\"Container\"\u003e\n      \u003cdiv class=\"Footer-links\"\u003e\n          \u003cdiv class=\"Footer-linkColumn\"\u003e\n            \u003ca aria-describedby=\"footer-description\" class=\"Footer-link Footer-link--primary\" href=\"https://go.dev/solutions/\"\u003e\n              为什么选择 Go\n            \u003c/a\u003e\n              \u003ca aria-describedby=\"footer-description\" class=\"Footer-link\" href=\"https://go.dev/solutions/use-cases\"\u003e\n                使用场景\n              \u003c/a\u003e\n              \u003ca aria-describedby=\"footer-description\" class=\"Footer-link\" href=\"https://go.dev/solutions/case-studies\"\u003e\n                案例研究\n              \u003c/a\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"Footer-linkColumn\"\u003e\n            \u003ca aria-describedby=\"footer-description\" class=\"Footer-link Footer-link--primary\" href=\"/learn/\"\u003e\n              入门\n            \u003c/a\u003e\n              \u003ca aria-describedby=\"footer-description\" class=\"Footer-link\" href=\"https://go.dev/play\"\u003e\n                Go 语言演练场\n              \u003c/a\u003e\n              \u003ca aria-describedby=\"footer-description\" class=\"Footer-link\" href=\"/tour/\"\u003e\n                Go 语言之旅\n              \u003c/a\u003e\n              \u003ca aria-describedby=\"footer-description\" class=\"Footer-link\" href=\"https://stackoverflow.com/questions/tagged/go?tab=Newest\"\u003e\n                Stack Overflow\n              \u003c/a\u003e\n              \u003ca aria-describedby=\"footer-description\" class=\"Footer-link\" href=\"https://go.dev/help/\"\u003e\n                帮助\n              \u003c/a\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"Footer-linkColumn\"\u003e\n            \u003ca aria-describedby=\"footer-description\" class=\"Footer-link Footer-link--primary\" href=\"https://pkg.go.dev\"\u0