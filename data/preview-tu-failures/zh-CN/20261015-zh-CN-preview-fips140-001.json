Go Programming Language\"/\u003e\n\u003ctitle\u003eFIPS 140-3 合规性 - Go 编程语言\u003c/title\u003e\n\n\u003cmeta name=\"og:image\" content=\"https://go.dev/doc/gopher/gopher5logo.jpg\"/\u003e\n\u003cmeta name=\"twitter:image\" content=\"https://go.dev/doc/gopher/gopherbelly300.jpg\"/\u003e\n\u003cmeta name=\"twitter:card\" content=\"summary\"/\u003e\n\u003cmeta name=\"twitter:site\" content=\"@golang\"/\u003e\n\u003c/head\u003e\n\u003cbody class=\"Site\"\u003e\n  \n\u003cnoscript\u003e\u003ciframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-W8MVQXG\"\n  height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"\u003e\u003c/iframe\u003e\u003c/noscript\u003e\n  \n\n\n\u003cheader class=\"Site-header js-siteHeader\"\u003e\n  \u003cdiv class=\"Header Header--dark\"\u003e\n    \u003cnav class=\"Header-nav\"\u003e\n      \u003ca href=\"/\"\u003e\n        \u003cimg class=\"js-headerLogo Header-logo\" src=\"/images/go-logo-white.svg\" alt=\"Go\"/\u003e\n      \u003c/a\u003e\n      \u003cdiv class=\"skip-navigation-wrapper\"\u003e\n        \u003ca aria-label=\"跳到主要内容\" class=\"skip-to-content-link\" href=\"/doc/security/fips140#main-content\"\u003e 跳到主要内容 \u003c/a\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"Header-rightContent\"\u003e\n        \u003cul class=\"Header-menu\"\u003e\n          \u003cli class=\"Header-menuItem \"\u003e\n            \u003ca aria-describedby=\"dropdown-description\" aria-label=\"为什么选择 Go\" class=\"js-desktop-menu-hover\" href=\"/doc/security/fips140\"\u003e\n              为什么选择 Go \u003ci aria-hidden=\"true\" class=\"material-icons\"\u003earrow_drop_down\u003c/i\u003e\n            \u003c/a\u003e\n            \u003cdiv class=\"screen-reader-only\" id=\"dropdown-description\" hidden=\"\"\u003e\n              按 Enter 键可activate/deactivate下拉菜单\n            \u003c/div\u003e\n              \u003cul class=\"Header-submenu js-desktop-submenu-hover\" aria-label=\"子菜单\"\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/solutions/case-studies\"\u003e\n                          案例研究\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e企业使用 Go 解决的常见问题\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/solutions/use-cases\"\u003e\n                          使用场景\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e企业如何以及为何使用 Go 的案例\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"/doc/security/\"\u003e\n                          安全\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003eGo 如何帮助你在默认情况下保障安全\u003c/p\u003e\n                  \u003c/li\u003e\n              \u003c/ul\u003e\n          \u003c/li\u003e\n          \u003cli class=\"Header-menuItem \"\u003e\n            \u003ca aria-describedby=\"dropdown-description\" aria-label=\"学习\" href=\"/learn/\"\u003e\n              学习 \n            \u003c/a\u003e\n            \u003cdiv class=\"screen-reader-only\" id=\"dropdown-description\" hidden=\"\"\u003e\n              按 Enter 键可activate/deactivate下拉菜单\n            \u003c/div\u003e\n          \u003c/li\u003e\n          \u003cli class=\"Header-menuItem  Header-menuItem--active\"\u003e\n            \u003ca aria-describedby=\"dropdown-description\" aria-label=\"文档\" class=\"js-desktop-menu-hover\" href=\"/doc/security/fips140\"\u003e\n              文档 \u003ci aria-hidden=\"true\" class=\"material-icons\"\u003earrow_drop_down\u003c/i\u003e\n            \u003c/a\u003e\n            \u003cdiv class=\"screen-reader-only\" id=\"dropdown-description\" hidden=\"\"\u003e\n              按 Enter 键可activate/deactivate下拉菜单\n            \u003c/div\u003e\n              \u003cul class=\"Header-submenu js-desktop-submenu-hover\" aria-label=\"子菜单\"\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/ref/spec\"\u003e\n                          Go 语言规范\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003eGo 语言的官方规范\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/doc\"\u003e\n                          Go 用户手册\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e使用 Go 构建软件的完整入门指南\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://pkg.go.dev/std\"\u003e\n                          标准库\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003eGo 标准库参考文档\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/doc/devel/release\"\u003e\n                          发行说明\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e了解每个 Go 版本的新变化\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/doc/effective_go\"\u003e\n                          Effective Go\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e编写清晰、高性能且符合 Go 惯用风格代码的技巧\u003c/p\u003e\n                  \u003c/li\u003e\n              \u003c/ul\u003e\n          \u003c/li\u003e\n          \u003cli class=\"Header-menuItem \"\u003e\n            \u003ca aria-describedby=\"dropdown-description\" aria-label=\"包\" href=\"https://pkg.go.dev\"\u003e\n              包 \n            \u003c/a\u003e\n            \u003cdiv class=\"screen-reader-only\" id=\"dropdown-description\" hidden=\"\"\u003e\n              按 Enter 键可activate/deactivate下拉菜单\n            \u003c/div\u003e\n          \u003c/li\u003e\n          \u003cli class=\"Header-menuItem \"\u003e\n            \u003ca aria-describedby=\"dropdown-description\" aria-label=\"社区\" class=\"js-desktop-menu-hover\" href=\"/doc/security/fips140\"\u003e\n              社区 \u003ci aria-hidden=\"true\" class=\"material-icons\"\u003earrow_drop_down\u003c/i\u003e\n            \u003c/a\u003e\n            \u003cdiv class=\"screen-reader-only\" id=\"dropdown-description\" hidden=\"\"\u003e\n              按 Enter 键可activate/deactivate下拉菜单\n            \u003c/div\u003e\n              \u003cul class=\"Header-submenu js-desktop-submenu-hover\" aria-label=\"子菜单\"\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/talks/\"\u003e\n                          演讲录像\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e往期活动视频\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://www.meetup.com/pro/go\"\u003e\n                          聚会活动\n                           \u003ci class=\"material-icons\"\u003eopen_in_new\u003c/i\u003e\n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e结识当地其他 Go 开发者\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/wiki/Conferences\"\u003e\n                          大会\n                           \u003ci class=\"material-icons\"\u003eopen_in_new\u003c/i\u003e\n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e与世界各地的 Go 开发者一起学习和交流\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/blog\"\u003e\n                          Go 博客\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003eGo 项目的官方博客。\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        \u003ca href=\"https://go.dev/help\"\u003e\n                          Go 项目\n                          \n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cp\u003e获取帮助并了解 Go 最新动态\u003c/p\u003e\n                  \u003c/li\u003e\n                  \u003cli class=\"Header-submenuItem\"\u003e\n                    \u003cdiv\u003e\n                        加入交流\n                    \u003c/div\u003e\n                    \u003cp\u003e\u003c/p\u003e\n                      \u003cdiv class=\"Header-socialIcons\"\u003e\n                        \n                        \u003ca aria-label=\"通过 google-groups 加入交流（在新窗口中