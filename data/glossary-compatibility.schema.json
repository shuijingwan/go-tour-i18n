{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-learning/glossary-compatibility/v1",
  "title": "Deterministic downstream glossary compatibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_kind", "locale", "old_glossary", "new_glossary", "new_full_review", "normalization_version", "impact_algorithm_version", "normalized_semantic_delta", "context_inventory", "affected_scopes", "compatible_scopes", "lineage", "evidence_identity_sha256"],
  "properties": {
    "schema": {"const": "go-learning/glossary-compatibility/v1"},
    "evidence_kind": {"const": "glossary-downstream-compatibility"},
    "locale": {"type": "string", "minLength": 1},
    "old_glossary": {"$ref": "#/$defs/reference"},
    "new_glossary": {"$ref": "#/$defs/reference"},
    "new_full_review": {"$ref": "#/$defs/reference"},
    "normalization_version": {"const": "tour-glossary-normalization/v1"},
    "impact_algorithm_version": {"const": "tour-visible-glossary-impact/v1"},
    "normalized_semantic_delta": {"type": "array", "items": {"$ref": "#/$defs/delta"}},
    "context_inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/context"}},
    "affected_scopes": {"type": "array", "items": {"$ref": "#/$defs/scope"}},
    "compatible_scopes": {"type": "array", "items": {"$ref": "#/$defs/scope"}},
    "lineage": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/reference"}},
    "evidence_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "delta": {
      "type": "object", "additionalProperties": false, "required": ["category", "term", "old", "new"],
      "properties": {
        "category": {"enum": ["mandatory", "preferred", "forbidden", "keep"]},
        "term": {"type": "string", "minLength": 1},
        "old": {"type": ["string", "null"]}, "new": {"type": ["string", "null"]}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "parser", "source", "target", "references", "context_identity_sha256"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "parser": {"enum": ["plain-visible/v1", "present-visible/v1", "go-comment-visible/v1", "unknown"]},
        "source": {"type": "string"}, "target": {"type": "string"},
        "references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
        "context_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["id", "context_identity_sha256", "reasons"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "context_identity_sha256": {"$ref": "#/$defs/sha256"},
        "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["semantic_delta_empty", "constraint_removed", "changed_source_term_absent", "new_forbidden_target_absent", "mandatory_source_term_present", "preferred_source_term_present", "keep_source_term_present", "new_forbidden_target_present", "unknown_parser"]}}
      }
    }
  }
}
