      },
      {
        "id": "6e34d1528e70fb9144f76f0f5875d3b014f2fc87e697bc667fbe9ffe3e5d0f99",
        "locator": "data/site-shell/translation.html#html/h2:35c8fb3d6cc96ecf26661c793d092d73bd86b504265fb9e88d6478df06132ae2:1",
        "source": "Local coverage",
        "source_sha256": "35c8fb3d6cc96ecf26661c793d092d73bd86b504265fb9e88d6478df06132ae2",
        "start": 2480,
        "end": 2494,
        "protected": []
      },
      {
        "id": "25a74374e54d3b9d5130b4286427077a16c448451df92b6dd22efd11c1372c75",
        "locator": "data/site-shell/translation.html#html/p:f7e2f8222ad4339b751409e47bd25faba194e21e423431485644b2d350aa1b58:1",
        "source": "A language can have different completion states for the Tour, documentation, and shared site content. The site's language directory uses validated local coverage; a language name alone does not promise that every page is available locally.",
        "source_sha256": "f7e2f8222ad4339b751409e47bd25faba194e21e423431485644b2d350aa1b58",
        "start": 2507,
        "end": 2746,
        "protected": []
      },
      {
        "id": "bd9fd4f1ced71104a36072bab3119e11cdd0bc797bd42da2d0c2fd6fdfadce68",
        "locator": "data/site-shell/translation.html#html/h2:fcb40e6dc253be52beaad2349e54fe352696a2bdb187ca617acb9ceb5419b9fc:1",
        "source": "Feedback and contributions",
        "source_sha256": "fcb40e6dc253be52beaad2349e54fe352696a2bdb187ca617acb9ceb5419b9fc",
        "start": 2802,
        "end": 2828,
        "protected": []
      },
      {
        "id": "6a7957a18bd75f9b68b6720dc5add96d30bb3b8fa540aa6ab14e2a057e164113",
        "locator": "data/site-shell/translation.html#html/p:d231f5d7c555c2152294a6d2b5cbe2461c9337ff1ef816aa8c43b5c6c7122dd6:1",
        "source": "Use the project issue tracker to report a translation problem or discuss a contribution. Include the language, page, and relevant text so the problem can be located. A community reference link is not evidence that a formal upstream application has been submitted.",
        "source_sha256": "d231f5d7c555c2152294a6d2b5cbe2461c9337ff1ef816aa8c43b5c6c7122dd6",
        "start": 2841,
        "end": 3104,
        "protected": []
      },
      {
        "id": "dd0825060cdff66126231cbf75ae9233436323d5aa02819b2feb0b97adf40832",
        "locator": "data/site-shell/translation.html#html/h2:7710371105064eb9fd2bb58b097978481b65ba018fb0dda0b1098023f4f97ec5:1",
        "source": "Generation and independent review",
        "source_sha256": "7710371105064eb9fd2bb58b097978481b65ba018fb0dda0b1098023f4f97ec5",
        "start": 3164,
        "end": 3197,
        "protected": []
      },
      {
        "id": "584a85d2b4a73393c0d9e2100d7f6896e3d57ed93d85c80ad6783a649303bca0",
        "locator": "data/site-shell/translation.html#html/p:af300ee53c4f8eef3c00c6aaba861bdcda4e735bdbc28639e86433f4ca52d024:1",
        "source": "Generation uses the canonical source and the language's reviewed glossary. Machine validation checks protected identities and structure. An independent Reviewer judges the language; the Generation session does not approve its own output.",
        "source_sha256": "af300ee53c4f8eef3c00c6aaba861bdcda4e735bdbc28639e86433f4ca52d024",
        "start": 3210,
        "end": 3447,
        "protected": []
      },
      {
        "id": "9773a11f051266ed2e8bdcbfa67f67adca12e1ed4c82f5b82c1d1f3a69cffec4",
        "locator": "data/site-shell/translation.html#html/p:5a4363637403dbbb4489da175208ab21f70824560185a7cf5c2018fb14fdc6c7:1",
        "source": "Reviewer findings return to Generation for a focused revision. A successor review checks that each finding category has been closed within its authorized scope. A content package can be finalized only when all of its formal translation units have an A rating.",
        "source_sha256": "5a4363637403dbbb4489da175208ab21f70824560185a7cf5c2018fb14fdc6c7",
        "start": 3459,
        "end": 3718,
        "protected": []
      },
      {
        "id": "e3366bf360d625385ae0886c86387a84d283e87db7b96ec7b8924bef1ef42407",
        "locator": "data/site-shell/translation.html#html/h2:3147a6bf6c2826f1fcedccef8041d62066632cb4f72215fc39a518c45eca4d7d:1",
        "source": "From completed content to release",
        "source_sha256": "3147a6bf6c2826f1fcedccef8041d62066632cb4f72215fc39a518c45eca4d7d",
        "start": 3777,
        "end": 3810,
        "protected": []
      },
      {
        "id": "be07c7cf2b074dbe25187b2546dc62b6f655d1f211ad1bf5e086546cb613e4cc",
        "locator": "data/site-shell/translation.html#html/p:91bc08d64361c05cd95b455423f5c714a85310afd1fc202758188011529432fd:1",
        "source": "Package closure binds the finalized translations and required shared language assets. Integrated Surface review checks their combination. Locale activation selects validated coverage; it does not replace language review.",
        "source_sha256": "91bc08d64361c05cd95b455423f5c714a85310afd1fc202758188011529432fd",
        "start": 3823,
        "end": 4043,
        "protected": []
      },
      {
        "id": "fedfc8fa24812ff420e58b0f9c444b339ee53b001ece5fb920d23c679f05ea16",
        "locator": "data/site-shell/translation.html#html/p:93d37c54249a0ccf4cc7896d89eb7607be4ac45fb566919fd7a16ecfee71464b:1",
        "source": "A fresh Preview and automated acceptance checks are followed by the maintainer's human check. Production publication is a separate step and does not turn unfinished or unreviewed content into completed translations.",
        "source_sha256": "93d37c54249a0ccf4cc7896d89eb7607be4ac45fb566919fd7a16ecfee71464b",
        "start": 4055,
        "end": 4270,
        "protected": []
      },
      {
        "id": "ddce630e15e00ee0a84d14c5832555a216f104476e429e006d464175e7dc4f1a",
        "locator": "data/site-shell/translation.html#html/h2:7a4735d52fff1773c255f4b85923108403102c7351daf298202c7db55163b144:1",
        "source": "Ongoing maintenance",
        "source_sha256": "7a4735d52fff1773c255f4b85923108403102c7351daf298202c7db55163b144",
        "start": 4325,
        "end": 4344,
        "protected": []
      },
      {
        "id": "6c30ce6903babf958991564bf83ed7c030023cb816972ad6b3f4099708c0831b",
        "locator": "data/site-shell/translation.html#html/p:b0aea0652665c9661c4712e4cbc3a7fd611d08ec7e64ceaca83a9838ae55eb05:1",
        "source": "Source and glossary changes are tracked through explicit identities and affected scopes. Verified unchanged work can be carried forward; affected work returns through validation and independent review. Historical generation and review evidence is preserved rather than rewritten.",
        "source_sha256": "b0aea0652665c9661c4712e4cbc3a7fd611d08ec7e64ceaca83a9838ae55eb05",
        "start": 4357,
        "end": 4636,
        "protected": []
      }
    ]
  },
