    "module.using_tour.title": {
      "kind": "plain",
      "text": "使用本導覽"
    },
    "module.using_tour.description": {
      "kind": "rich",
      "text": "<p>歡迎使用<a href=\"https://go.dev\">Go 程式語言</a>導覽。本導覽主要涵蓋這門語言最重要的功能：</p>"
    },
    "module.basics.title": {
      "kind": "plain",
      "text": "基礎"
    },
    "module.basics.description": {
      "kind": "rich",
      "text": "<p>從起點開始，學習這門語言的所有基礎知識。</p><p>包括宣告變數、呼叫函數，以及進入下一個課節前需要掌握的一切。</p>"
    },
    "module.methods.title": {
      "kind": "plain",
      "text": "方法和介面"
    },
    "module.methods.description": {
      "kind": "rich",
      "text": "<p>學習如何在類型上定義方法、如何宣告介面，以及如何把這些概念組合運用。</p>"
    },
    "module.generics.title": {
      "kind": "plain",
      "text": "泛型"
    },
    "module.generics.description": {
      "kind": "rich",
      "text": "<p>學習如何在 Go 函數和結構中使用類型參數。</p>"
    },
    "module.concurrency.title": {
      "kind": "plain",
      "text": "並行處理"
    },
    "module.concurrency.description": {
      "kind": "rich",
      "text": "<p>Go 提供並行處理功能，並將其納入核心語言。</p><p>本模組介紹 goroutine 和通道，以及如何運用它們實作不同的並行處理模式。</p>"
    },
