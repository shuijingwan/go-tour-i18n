* መሠረታዊ ዓይነቶች

የGo መሠረታዊ ዓይነቶች እነዚህ ናቸው፦

	bool

	string

	int  int8  int16  int32  int64
	uint uint8 uint16 uint32 uint64 uintptr

	byte // ለ uint8 ተለዋጭ ስም

	rune // ለ int32 ተለዋጭ ስም
	     // የUnicode ኮድ ነጥብን ይወክላል

	float32 float64

	complex64 complex128

ምሳሌው የበርካታ ዓይነቶች ተለዋዋጮችን ያሳያል፣
እንዲሁም የተለዋዋጭ መግለጫዎች እንደ አስገባ መግለጫዎች ሁሉ
በብሎኮች ውስጥ ሊደራጁ እንደሚችሉ ያሳያል።

የ `int`፣ `uint` እና `uintptr` ዓይነቶች በ32-bit ስርዓቶች ላይ ብዙውን ጊዜ 32 ቢት፣ በ64-bit ስርዓቶች ላይ ደግሞ 64 ቢት ስፋት አላቸው።
የኢንቲጀር እሴት ሲያስፈልግዎ የተወሰነ መጠን ያለው ወይም ምልክት-አልባ የኢንቲጀር ዓይነት ለመጠቀም ልዩ ምክንያት ከሌለዎት `int` ን መጠቀም አለብዎት።

.play basics/basic-types.go
