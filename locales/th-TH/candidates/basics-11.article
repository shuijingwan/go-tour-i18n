* ชนิดพื้นฐาน

ชนิดพื้นฐานของ Go ได้แก่

	bool

	string

	int  int8  int16  int32  int64
	uint uint8 uint16 uint32 uint64 uintptr

	byte // เป็นนามแฝงของ uint8

	rune // เป็นนามแฝงของ int32
	     // แทนจุดรหัส Unicode

	float32 float64

	complex64 complex128

ตัวอย่างนี้แสดงตัวแปรหลายชนิด
และยังแสดงให้เห็นว่าการประกาศตัวแปรสามารถรวมเป็นบล็อกแบบ "รวมกลุ่ม"
ได้เช่นเดียวกับคำสั่งอิมพอร์ต

ชนิด `int`, `uint` และ `uintptr` โดยทั่วไปมีความกว้าง 32 บิตบนระบบ 32 บิต และ 64 บิตบนระบบ 64 บิต
เมื่อคุณต้องการค่าจำนวนเต็ม ควรใช้ `int` เว้นแต่จะมีเหตุผลเฉพาะที่ต้องใช้ชนิดจำนวนเต็มที่กำหนดขนาดหรือชนิดจำนวนเต็มแบบไม่มีเครื่องหมาย

.play basics/basic-types.go
