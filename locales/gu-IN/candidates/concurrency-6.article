* ડિફૉલ્ટ પસંદગી

બીજો કોઈ કેસ તૈયાર ન હોય ત્યારે `default` કેસ `select` માં ચાલે છે.

બ્લોક થયા વિના મૂલ્ય મોકલવાનો કે મેળવવાનો પ્રયાસ કરવા `default` કેસ વાપરો:

	select {
	case i := <-c:
		// i નો ઉપયોગ કરો
	default:
		// c માંથી મૂલ્ય મેળવવાથી બ્લોક થશે
	}

.play concurrency/default-selection.go
