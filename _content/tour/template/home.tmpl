<!doctype html>
<html lang="{{.HTMLLang}}" data-theme="auto">
<head>
{{.AnalyticsHTML}}{{.AdHTML}}    <meta charset="utf-8">
    <title>{{ui "site.browser_title"}}</title>
    <meta name="description" content="{{ui "site.intro"}}">
    <link rel="canonical" href="{{.SEOOrigin}}/">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="{{asset "tour/static/css/app.css"}}">
    <link rel="icon" href="{{asset "images/site-logo-32.png"}}" type="image/png" sizes="32x32">
    <link rel="icon" href="{{asset "images/site-logo.png"}}" type="image/png" sizes="512x512">
</head>
<body class="site-home">
    <header class="bar top-bar site-header">
        <a href="/"><img src="{{asset "images/site-logo.png"}}" class="site-logo" alt=""></a>
        <a class="logo" href="/">{{ui "site.title"}}</a>
    </header>
    <main class="site-main">
        <section class="site-hero">
            <p class="site-eyebrow">{{ui "site.unofficial"}}</p>
            <h1>{{ui "site.title"}}</h1>
            <p>{{ui "site.intro"}}</p>
            <p>{{ui "site.no_affiliation"}}</p>
            <a class="site-primary-link" href="/tour/welcome/1">{{ui "site.start_learning"}}</a>
        </section>
        <section class="site-section">
            <h2>{{ui "site.current_projects"}}</h2>
            <article class="site-card">
                <h3>{{ui "tour.title"}}</h3>
                <p>{{ui "site.tour_description"}}</p>
                <p><strong>{{ui "site.current_language"}}：</strong>{{.CurrentLanguage.Autonym}}</p>
                <a href="/tour/welcome/1">{{ui "site.enter_tour"}}</a>
            </article>
        </section>
        <section class="site-section">
            <h2>{{ui "site.project_status"}}</h2>
            <dl class="site-status">
                <dt>{{ui "site.current_language"}}</dt><dd>{{.CurrentLanguage.Autonym}}</dd>
                <dt>{{ui "site.course_pages"}}</dt><dd>{{.Metadata.Pages}}</dd>
                {{if .Development}}<dt>{{ui "site.environment"}}</dt><dd>{{ui "site.development_environment"}}</dd>{{else}}<dt>{{ui "site.latest_release"}}</dt><dd>{{.PublishedAt}}</dd>{{end}}
                <dt>{{ui "site.upstream_baseline"}}</dt><dd><a href="{{.UpstreamCommitURL}}" target="_blank" rel="noopener noreferrer">golang/website@{{.ShortUpstreamCommit}}</a></dd>
                <dt>{{ui "site.upstream_commit_time"}}</dt><dd>{{.UpstreamCommitTime}}</dd>
            </dl>
        </section>
        <section class="site-section">
            <h2>{{ui "site.language_versions"}}</h2>
            <ul class="site-language-list">
                {{range .Languages}}<li>{{if .Current}}<span aria-current="page">{{.Autonym}}</span>{{else}}<a href="{{.URL}}"{{if .Official}} target="_blank" rel="noopener noreferrer"{{end}}>{{.Autonym}}</a>{{end}}</li>{{end}}
            </ul>
        </section>
        <section class="site-section">
            <h2>{{ui "site.project_links"}}</h2>
            <ul class="site-links">
                <li><a href="{{.GitHubURL}}" target="_blank" rel="noopener noreferrer">{{ui "site.source_code"}}</a></li>
                <li><a href="{{.GitHubIssuesURL}}" target="_blank" rel="noopener noreferrer">{{ui "site.issue_feedback"}}</a></li>
                <li><a href="{{.DevelopmentLogURL}}" target="_blank" rel="noopener noreferrer">{{ui "site.development_log"}}</a></li>
                <li><a href="{{.UpstreamURL}}" target="_blank" rel="noopener noreferrer">{{ui "site.official_upstream"}}</a></li>
            </ul>
        </section>
        <section class="site-section">
            <h2>{{ui "site.translation_validation"}}</h2>
            <p>{{ui "site.translation_validation_intro"}}</p>
            <ul class="site-validation-list">
                <li>{{ui "site.validation_page_unit"}}</li><li>{{ui "site.validation_present"}}</li><li>{{ui "site.validation_structure"}}</li><li>{{ui "site.validation_render"}}</li><li>{{ui "site.validation_examples"}}</li>
            </ul>
        </section>
        <section class="site-section">
            <h2>{{ui "site.how_it_works"}}</h2>
            <p>{{ui "site.how_it_works_intro"}}</p>
            <div class="site-card">
                <h3>{{ui "site.workflow_title"}}</h3>
                <p>{{ui "site.workflow_units"}}</p>
                <p>{{ui "site.workflow_process"}}</p>
                <p>{{ui "site.workflow_review"}}</p>
                <p>{{ui "site.workflow_publish"}}</p>
            </div>
            <div class="site-card site-card-following">
                <h3>{{ui "site.architecture_title"}}</h3>
                <p>{{ui "site.architecture_upstream"}}</p>
                <p>{{ui "site.architecture_playground"}}</p>
                <p>{{ui "site.architecture_languages"}}</p>
            </div>
            <p>{{ui "site.operations_note"}}</p>
        </section>
        <section class="site-section">
            <h2>{{ui "site.continue_learning_title"}}</h2>
            <article class="site-card">
                <p>{{ui "site.continue_learning_description"}}</p>
                <a class="site-primary-link site-learning-link" href="https://go.dev/" target="_blank" rel="noopener noreferrer">{{ui "site.continue_learning"}}</a>
            </article>
        </section>
    </main>
    {{template "footer" .}}
</body>
</html>
