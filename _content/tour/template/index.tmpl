<!doctype html>
<html lang="{{.HTMLLang}}" dir="{{.Direction}}" ng-app="tour" data-theme="auto">

<head>
<script id="tour-runtime-head"></script>{{.AnalyticsHTML}}{{.AdHTML}}    <meta charset="utf-8">
    <title>{{.Title}}</title>
    <link rel="canonical" href="{{.Canonical}}">
    <meta name="description" content="{{.Description}}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <script>
      (function() {
        const theme = document.cookie.match(/prefers-color-scheme=(light|dark|auto)/)?.[1]
        if (theme) {
          document.querySelector('html').setAttribute('data-theme', theme);
        }
      }())
    </script>
    <link rel="stylesheet" href="{{asset "tour/static/css/app.css"}}" />
    {{if .TourAdsEnabled}}<link rel="stylesheet" href="{{asset "tour/static/go-dev/course-ad.css"}}">{{end}}
    <link rel="stylesheet" href="{{asset "tour/static/lib/codemirror/lib/codemirror.css"}}">
    <link href='https://fonts.googleapis.com/css?family=Inconsolata' rel='stylesheet' type='text/css'>
    <link rel="icon" href="{{asset "images/site-logo-32.png"}}" type="image/png" sizes="32x32">
    <link rel="icon" href="{{asset "images/site-logo.png"}}" type="image/png" sizes="512x512">
</head>

<body>
    <div class="bar top-bar">
        <div class="left">
        <a href="/"><img src="{{asset "images/go-logo-white.svg"}}" class="gopherlogo"></a>
        <a class="logo" href="/tour/list">{{ui "tour.title"}}</a>
        </div>
        <div class="right">
            <div class="header-project-nav">
              <a class="header-control header-about" href="/" aria-label="{{ui "header.about_project"}}" title="{{ui "header.about_project"}}">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11 17h2v-6h-2v6zm1-15a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm-1-11h2V7h-2v2z"></path></svg>
                <span class="header-control-label">{{ui "header.about_project"}}</span>
              </a>
              <details class="header-language">
                <summary class="header-control" aria-label="{{ui "site.current_language"}}: {{.CurrentLanguage.Autonym}}" title="{{ui "site.language_versions"}}">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.92 6h-2.95a15.7 15.7 0 0 0-1.38-3.56A8.06 8.06 0 0 1 18.92 8zM12 4c.83 1.2 1.46 2.54 1.86 4h-3.72A13.7 13.7 0 0 1 12 4zM4.26 14a7.8 7.8 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4h-3.4zm.82 2h2.95c.3 1.25.76 2.44 1.38 3.56A8.06 8.06 0 0 1 5.08 16zM8.03 8H5.08a8.06 8.06 0 0 1 4.33-3.56A15.7 15.7 0 0 0 8.03 8zM12 20a13.7 13.7 0 0 1-1.86-4h3.72A13.7 13.7 0 0 1 12 20zm2.28-6H9.72a14.3 14.3 0 0 1 0-4h4.56a14.3 14.3 0 0 1 0 4zm.31 5.56A15.7 15.7 0 0 0 15.97 16h2.95a8.06 8.06 0 0 1-4.33 3.56zM16.34 14a16.5 16.5 0 0 0 0-4h3.4a7.8 7.8 0 0 1 0 4h-3.4z"></path></svg>
                  <span class="header-language-current">{{.CurrentLanguage.Autonym}}</span>
                </summary>
                <div class="header-language-menu">
                  <div class="header-language-heading">{{ui "site.language_versions"}}</div>
                  <ul>
                    {{range .Languages}}<li>{{if .Current}}<span aria-current="page">{{.Label}}</span>{{else}}<a href="{{.URL}}"{{if .Official}} target="_blank" rel="noopener noreferrer"{{end}}>{{.Label}}</a>{{end}}</li>{{end}}
                  </ul>
                </div>
              </details>
            </div>
            <button class="header-toggleTheme js-toggleTheme" aria-label="{{ui "theme.toggle"}}">
              <img
                data-value="auto"
                class="go-Icon go-Icon--inverted"
                height="24"
                width="24"
                src="{{asset "images/icons/brightness_6_gm_grey_24dp.svg"}}"
                alt="{{ui "theme.system"}}">
              <img
                data-value="dark"
                class="go-Icon go-Icon--inverted"
                height="24"
                width="24"
                src="{{asset "images/icons/brightness_2_gm_grey_24dp.svg"}}"
                alt="{{ui "theme.dark"}}">
              <img
                data-value="light"
                class="go-Icon go-Icon--inverted"
                height="24"
                width="24"
                src="{{asset "images/icons/light_mode_gm_grey_24dp.svg"}}"
                alt="{{ui "theme.light"}}">
            </button>
            <div table-of-contents-button=".toc"></div>
            <div feedback-button></div>
        </div>
    </div>

    <div table-of-contents></div>

    <div ng-view ng-cloak class="ng-cloak"></div>
    {{template "footer" .}}

    {{if .TourAdsEnabled}}<script src="{{asset "tour/static/go-dev/course-ad.js"}}"></script>{{end}}
    <script src="/tour/script.js"></script>
</body>

</html>

{{define "footer"}}
<footer class="site-footer">
    <div>{{ui "footer.unofficial"}} · <a href="/">{{ui "footer.home"}}</a> · <a href="{{.GitHubURL}}" target="_blank" rel="noopener noreferrer">{{ui "footer.github"}}</a>{{if .OwnerContentLinksEnabled}} · <a href="{{.DevelopmentLogURL}}" target="_blank" rel="noopener noreferrer">{{ui "footer.development_log"}}</a>{{end}}</div>
    <div>© 2026 {{.CopyrightHolder}} | <a href="{{.ICPURL}}" target="_blank" rel="noopener noreferrer">{{.ICPNumber}}</a></div>
</footer>
{{end}}
